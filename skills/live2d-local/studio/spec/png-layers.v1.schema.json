{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cropped PNG layer input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "width",
    "height",
    "license",
    "parameters",
    "layers"
  ],
  "properties": {
    "format": {
      "const": "studio-png-layers"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "parameters": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "min",
          "max",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string"
          },
          "min": {
            "const": 0
          },
          "max": {
            "const": 1
          },
          "default": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "semantics": {
            "enum": [
              "eye-open-01",
              "eye-close-01"
            ]
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "file",
          "sha256",
          "left",
          "top",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Safe relative .png path; symlink escapes forbidden"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "role": {
            "type": "string"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bind": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameterId",
              "kind",
              "strength"
            ],
            "properties": {
              "parameterId": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "breath",
                  "blink",
                  "mouth",
                  "sway"
                ]
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1
              }
            }
          }
        }
      }
    }
  }
}
